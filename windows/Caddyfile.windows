# EV211 Windows 네이티브(도커 없음) Caddy 설정 — 루트 Caddyfile 과 동일한 보안 동작, 업스트림만 루프백 직결
# install.ps1 이 <Root>\app\Caddyfile 로 복사하고 ev211-caddy 서비스(WinSW)가 실행한다.
# 서비스 환경변수(WinSW XML 이 주입):
#   {$FIELD_NODE_IP}   서버 LAN IP(ev211.env 의 FIELD_NODE_IP). 미설정 시 127.0.0.1.
#   {$FIELD_WEB_ROOT}  정적 웹 루트(<Root>\app\web, 슬래시 구분 경로). 미설정 시 기동 실패하도록 기본값 없음.
#   XDG_DATA_HOME/XDG_CONFIG_HOME  Caddy internal CA·인증서 저장 위치(<Root>\data\caddy-data|caddy-config).
# 도커판과의 차이:
#   - livekit:7880 / field-api:8000 (도커 DNS) → 127.0.0.1:7880 / 127.0.0.1:8000 (같은 호스트 프로세스).
#   - 도커판은 compose 가 8880 을 127.0.0.1 에만 publish 해 루프백 전용을 보장했다. 네이티브에서는
#     publish 단계가 없으므로 localhost:8880 사이트에 `bind 127.0.0.1` 을 명시해 같은 경계를 만든다.
{
	# 관리 API 비활성(내부망 정적 서빙만)
	admin off
	# 도커판(컨테이너)은 호스트 신뢰 저장소에 루트 CA 를 설치하지 못한다. 네이티브 SYSTEM 서비스는
	# 설치에 성공해 서버 PC 의 신뢰 저장소를 바꿀 수 있으므로, 도커판과 같게 설치를 건너뛴다.
	# 서버 PC 자신은 http://localhost:8880 을 쓰고, 다른 단말은 README 의 루트 CA 배포 절차를 따른다.
	skip_install_trust
	# IP 직접 접속(https://<서버IP>:8443)은 SNI 가 비어 Caddy 가 인증서를 선택하지 못하고
	# TLS alert 80(internal error)으로 끊는다. 빈 SNI 의 기본 인증서를 서버 LAN IP 로 지정한다.
	default_sni {$FIELD_NODE_IP:127.0.0.1}
}

# 경로 0: 편의 리다이렉트 — 브라우저에 IP 만 입력(http :80)하면 https:8443 으로 안내한다.
# 콘텐츠·프록시 없음(리다이렉트 전용).
http://:80 {
	redir https://{host}:8443{uri} permanent
}

# 공통 보안 헤더 스니펫: MIME 스니핑·클릭재킹 방지, 리퍼러 최소화, 서버 배너 제거.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 공개 수신·관리자 페이지는 운영 중 자주 갱신되므로 브라우저 재검증 없이 저장하지 않는다.
(web_no_cache) {
	@web_page path / /index.html /admin.html /i18n.js
	header @web_page {
		Cache-Control "no-store, max-age=0, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}
}

# 경로 1: 서버 PC 자신 — localhost http. getUserMedia 는 localhost 에서 보안 컨텍스트로 허용됨.
# ⚠ 반드시 루프백에만 바인딩한다. 전 인터페이스에 열면 LAN 단말이 Host: localhost 로 보내
#   아래 XFF=127.0.0.1 고정(루프백 인증 예외)을 우회할 수 있다. 외부 경로는 https:8443 만 남긴다.
#   (IPv6 ::1 은 바인딩하지 않는다 — 브라우저·curl 은 ::1 거부 시 127.0.0.1 로 폴백한다.)
http://localhost:8880 {
	bind 127.0.0.1
	import security_headers
	import web_no_cache
	# LiveKit signaling ws 프록시 (http 경로에서는 ws). 같은 호스트의 livekit-server 로 직결.
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	# field-api 제어 평면 프록시. /api 프리픽스를 스트립해 127.0.0.1:8000 으로 전달한다.
	# 이 블록은 루프백 전용이므로 X-Forwarded-For 를 127.0.0.1 로 고정해
	# field-api 의 루프백 http 인증 예외를 트리거한다(루트 Caddyfile 과 동일).
	# LiveKit 웹훅(http://localhost:8880/api/livekit/webhook)도 이 경로로 들어온다.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto http
			header_up X-Forwarded-For 127.0.0.1
		}
	}
	handle {
		root * "{$FIELD_WEB_ROOT}"
		file_server
		encode gzip
	}
}

# 경로 2: 다른 내부망 단말 — 자체서명 https. Caddy internal CA 로 TLS 발급.
# 명시적 호스트명 필요(bare :8443 은 빈 SNI 로 internal CA 발급 실패).
# 인증서 대상에 서버 LAN IP({$FIELD_NODE_IP})를 포함해야 외부 노트북이 IP 로 접속 가능.
localhost:8443, 127.0.0.1:8443, {$FIELD_NODE_IP:127.0.0.1}:8443 {
	tls internal
	import security_headers
	import web_no_cache
	# LiveKit signaling wss 프록시. https 페이지는 mixed content 회피 위해 wss(/rtc)로 접속.
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	# field-api 제어 평면 프록시(https). X-Forwarded-Proto=https 를 명시 전달 → 인증 요청 허용.
	# X-Forwarded-For 는 Caddy 기본 동작(실제 접속 IP 설정, 수신 XFF 불신)을 유지한다.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		root * "{$FIELD_WEB_ROOT}"
		file_server
		encode gzip
	}
}
